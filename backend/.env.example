# Environment variables read by the backend (all optional, defaults shown).
# The app does not load .env files itself: export these in your shell or process manager.
# DEVBOOK_DATA_DIR=<repo>/data
DEVBOOK_CHAT_MODEL=qwen2.5-coder:7b
DEVBOOK_EMBED_MODEL=nomic-embed-text
DEVBOOK_OLLAMA_URL=http://127.0.0.1:11434
DEVBOOK_TOP_K=6
DEVBOOK_NUM_CTX=8192
DEVBOOK_MAX_DISTANCE=0.6
DEVBOOK_KEEP_ALIVE=10m
DEVBOOK_MAX_UPLOAD_MB=200
DEVBOOK_MAX_PAGES=2000
DEVBOOK_RUN_TIMEOUT=10
DEVBOOK_OCR=0
DEVBOOK_CORS_ORIGIN=http://localhost:3000
DEVBOOK_LOG_LEVEL=INFO
